# Copy to `.dev.vars` for local `wrangler dev`. `.dev.vars` is gitignored.
# In production these are set with `wrangler secret put <NAME>` instead.

# GitHub App installation token, or a fine-grained PAT for local testing.
# Needs Contents: read/write and Pull requests: read/write on the target repo.
GITHUB_TOKEN="ghp_replace_me"

# Optional shared secret, accepted in the email subject as [token]. Only
# required when SPF/DKIM verdicts cannot vouch for a message — see README.
EMAIL_SUBJECT_TOKEN=""

# Comma-separated envelope sender addresses permitted to create posts.
ALLOWED_SENDERS="you@example.com"

# Bearer token for the HTTPS POST path.
API_TOKEN="replace-with-a-long-random-string"

# Set to "false" only if your mail platform does not stamp SPF/DKIM results.
# Leaving it unset (or "true") fails closed, which is what you want.
REQUIRE_AUTH_RESULTS="true"

# Set to "false" to keep email signatures in the post body. On by default;
# only the standard "-- " delimiter is recognised.
STRIP_SIGNATURE="true"

# Set to "true" to commit posts with `draft: true`. Off by default: many
# templates hide drafts from production builds, which includes Vercel
# previews, so a draft post 404s on the preview meant for reviewing it.
POST_AS_DRAFT="false"

# Per-site overrides of the two globals above. A site falls back to the global
# value when it does not set its own. A per-site GitHub token is the better
# setup with several sites: one scoped to a single repo cannot reach the others.
# MYSITE_GITHUB_TOKEN=""
# MYSITE_EMAIL_SUBJECT_TOKEN=""
