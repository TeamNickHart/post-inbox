{
  // Copy this to `sites.jsonc` and fill in your own sites. `sites.jsonc` is
  // gitignored: it names the addresses that accept mail and the repos that
  // get written to, which is not something to publish.
  //
  // Each site's SECRETS are separate, named from its `key` uppercased, with
  // hyphens becoming underscores:
  //
  //   npx wrangler secret put MYSITE_ALLOWED_SENDERS
  //   npx wrangler secret put MYSITE_API_TOKEN
  //
  // `_ALLOWED_SENDERS` is a comma-separated list of envelope addresses
  // permitted to post, and is required.
  // `_API_TOKEN` is the bearer token for the HTTPS path, and is optional —
  // omit it for a site that only accepts email.
  "sites": [
    {
      // Lowercase letters, digits and hyphens only: this becomes the
      // environment-variable prefix above.
      "key": "mysite",

      // The address you mail posts to. Set this up in Cloudflare Email
      // Routing as "Send to a Worker". One address per site: the address the
      // mail was sent to is what selects the site.
      "inboundAddresses": ["draft@example.com"],

      // Where posts get committed.
      "owner": "your-github-org",
      "repo": "your-blog-repo",
      "baseBranch": "main",

      // For the Tailwind Nextjs Starter Blog these are the right values.
      "contentPath": "data/blog",
      "extension": ".mdx",

      // Where emailed attachments are committed, and the URL the site serves
      // that directory at. Omit the whole block to refuse attachments — they
      // are then reported in the pull request rather than silently dropped.
      // These are the right values for the Tailwind starter.
      "assets": {
        "directory": "public/static/images",
        "urlPrefix": "/static/images"

        // Optional, default true: convert HEIC to JPEG on the way in, using
        // the Cloudflare Images binding. An iPhone shoots HEIC by default and
        // no browser renders it, so without this a photo emailed from iOS is
        // refused rather than committed. Set false to keep that refusal.
        // "convertImages": false
      },

      // Required. This is the sender allowlist as well as the author map: an
      // address not listed here cannot post at all, which is why a site with an
      // empty map is rejected at build time rather than on the first email.
      //
      // Maps an envelope address to a file in the site's `data/authors`
      // directory. An address whose author file is the site default can point
      // at `default`.
      //
      // The value is a bare basename — no directory, no `.mdx`. It must match
      // a file that exists: frontmatter naming a missing author breaks the
      // site build. Run `pnpm check:authors` after editing this.
      //
      // Optional: extra frontmatter fields this site's schema accepts, beyond
      // the title/date/tags/draft/summary/authors every post has. A sender
      // sets one from the email header block (`Pillar: Leading`, keys
      // case-insensitive) or as a top-level key in the HTTPS body.
      //
      // Declaring a field is the only way a header line becomes frontmatter.
      // Omit this and `Pillar: Leading` at the top of an email stays part of
      // the post body, exactly as it did before this existed.
      //
      // "enum" takes a map of the value that reaches the frontmatter to the
      // other spellings a sender may type for it. A stored value always
      // accepts itself, so listing `[]` means "this value, however
      // capitalised". Aliases exist because a site's labels often differ from
      // what it stores — a badge reading "Leading" for a stored `leadership` —
      // and someone writing an email types what they read.
      //
      // An unrecognised value is refused in the bounce, naming what is
      // accepted, rather than written as frontmatter that breaks the build.
      //
      // "string" is stored as written. Use it where the value is open-ended,
      // or where the site itself warns about unknown values at build time.
      // "extraFields": {
      //   "pillar": {
      //     "type": "enum",
      //     "values": {
      //       "build": ["building"],
      //       "leadership": ["leading"],
      //       "fun": []
      //     }
      //   },
      //   "project": { "type": "string" }
      // },

      // Optional: frontmatter added to every post for this site. A header-block
      // value for the same key overrides it, so this is a starting point rather
      // than a constraint. Useful where every post uses one layout.
      // "frontmatter": { "layout": "PostBanner" },

      // Optional: note in the pull request when the summary is missing or
      // shorter than this. Advisory only — never a rejection. A summary is what
      // link previews and search results show; LinkedIn's Post Inspector warns
      // under 100 characters.
      // "summaryMinLength": 100,

      "authorsBySender": {
        "you@example.com": "default",
        "someone-else@example.com": "someone-else"
      }
    }
  ]
}
