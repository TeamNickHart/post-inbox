{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "post-inbox",
  "main": "src/adapters/cloudflare/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }

  // Site configuration lives in `sites.jsonc`, which is gitignored because
  // this repo is public — `scripts/build-sites.mjs` compiles it into the
  // bundle. Secrets are set with `pnpm configure` and
  // `pnpm configure:site <key>`; see README.
}
